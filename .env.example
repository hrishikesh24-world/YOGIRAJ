# Copy this to .env and fill in your values

# --- NEXTAUTH ---
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=https://your-vercel-domain.vercel.app

# --- DATABASE (Neon PostgreSQL) ---
# Get these from https://console.neon.tech → Your Project → Connection Details
# Use "Pooled connection" for DATABASE_URL, "Direct connection" for DIRECT_URL
DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
DIRECT_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
